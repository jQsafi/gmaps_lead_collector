# Groq AI API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Remote Database Connection URI for Permanent Lead Storage
# Supported: PostgreSQL (Supabase, Neon, Railway, RDS), MySQL, SQLite

# Example 1: Supabase PostgreSQL (Recommended free cloud DB)
# DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Example 2: Neon.tech PostgreSQL (Free cloud DB)
# DATABASE_URL=postgresql://alex:AbCdEf123@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Example 3: Standard Remote PostgreSQL
# DATABASE_URL=postgresql://username:password@remote_host_ip:5432/leads_database

# Example 4: Remote MySQL
# DATABASE_URL=mysql+pymysql://username:password@remote_host_ip:3306/leads_database

# Fallback (Local SQLite)
DATABASE_URL=sqlite:///gmaps_leads_archive.db
